{
    "name": "axn/laravel-models-organizer",
    "description": "Organize Laravel models concerns (relations, scopes, attributes) in dedicated traits.",
    "homepage": "https://github.com/AXN-Informatique/laravel-models-organizer",
    "support": {
        "issues": "https://github.com/AXN-Informatique/laravel-models-organizer/issues",
        "source": "https://github.com/AXN-Informatique/laravel-models-organizer"
    },
    "type": "library",
    "authors": [
        {
            "name": "AXN Informatique",
            "email": "developpement@axn.fr"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0 || ^13.0",
        "nikic/php-parser": "^5.7"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7.3",
        "laravel/pint": "^1.32.1",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3.5",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "phpunit/phpunit": "^13.4.5",
        "rector/rector": "^2.8.4"
    },
    "autoload": {
        "psr-4": {
            "Axn\\ModelsOrganizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Axn\\ModelsOrganizer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "@php -d xdebug.mode=coverage vendor/bin/pest --coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Axn\\ModelsOrganizer\\ServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
